# Copy to .env and adjust. All values have safe dev defaults in app/config.py.

# SQLAlchemy URL. Default is a local SQLite file; for production use Postgres, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/pyportfolios
DATABASE_URL=sqlite:///./pyportfolios.db

# Secret used for session-token entropy hardening. MUST be overridden in production.
SESSION_SECRET=dev-secret-change-me

# Set true when serving over HTTPS (nginx terminates TLS in production).
COOKIE_SECURE=false

# "mock" (default, no external calls) or "stripe".
PAYMENT_PROVIDER=mock

# Stripe (only needed when PAYMENT_PROVIDER=stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_LIFETIME=

# Gated content (paid vault; served only through the API — the static site no
# longer ships it). Paths are relative to the platform/ working directory.
CONTENT_NOTEBOOKS_DIR=../vault/notebooks
CONTENT_BUNDLES_DIR=../vault/bundles

# Email backend: "console" (default; DEV ONLY — logs emails incl. reset tokens
# via the application log) or "smtp" (requires the SMTP_* settings below).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pyportfolios.com
